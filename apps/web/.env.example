# --- Mode ---
# sandbox = in-process GHL-compatible demo (zero keys). live = real GoHighLevel.
GHL_MODE=sandbox

# Sandbox persistence: memory | file | upstash
SANDBOX_STORE=memory
# Only used when SANDBOX_STORE=file (local dev keeps data on disk; never on Vercel).
SANDBOX_DATA_DIR=.sandbox-data
# Optional API key the sandbox requires on its own routes (leave empty in the demo).
SANDBOX_API_KEY=

# Only used when SANDBOX_STORE=upstash (Upstash Redis via Vercel Marketplace).
KV_REST_API_URL=
KV_REST_API_TOKEN=

# --- Live GHL mode ---
GHL_API_URL=https://services.leadconnectorhq.com
GHL_API_KEY=
# The Location for this clinic (kept out of the repo).
GHL_LOCATION_ID=

# --- Webhooks ---
# Canonical public URL of this deployment. The sandbox uses it to subscribe the
# app's own receiver, so automation fires even with zero external services.
PUBLIC_BASE_URL=http://localhost:3000
# Shared secret used to sign/verify outbound and inbound webhooks (also n8n's).
WEBHOOK_SECRET=local-demo-secret

# --- Demo auth ---
# Passcode for the ops dashboard. API routes require this in the X-API-Secret
# header when called from n8n or Vercel Cron.
DEMO_PASSCODE=mercy

# --- Vercel Cron ---
CRON_SECRET=local-demo-secret
