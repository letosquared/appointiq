{
  "name": "No-show → Auto Rebook + WhatsApp",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "ghl-appointment",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "node-webhook",
      "name": "GHL Appointment Event",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [-360, 180]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "typeValidation": "loose" },
          "conditions": [
            { "leftValue": "={{ String($json.type).toLowerCase() }}", "rightValue": "appointmentstatuschanged", "operator": { "type": "string", "operation": "equals" } },
            { "leftValue": "={{ $json.data.newStatus }}", "rightValue": "no-show", "operator": { "type": "string", "operation": "equals" } }
          ]
        },
        "options": {}
      },
      "id": "node-filter",
      "name": "Is a no-show?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [-80, 180]
    },
    {
      "parameters": {
        "url": "https://appointiq-webp.vercel.app/api/automations/rebook",
        "method": "POST",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "X-API-Secret", "value": "={{ $env.WEBHOOK_SECRET }}" },
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{\n  \"appointmentId\": \"={{ $json.data.appointmentId }}\"\n}",
        "options": {}
      },
      "id": "node-rebook",
      "name": "Vercel: rebook next free slot + queue WhatsApp",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [200, 180]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "typeValidation": "loose" },
          "conditions": [
            { "leftValue": "={{ $json.ok }}", "rightValue": true, "operator": { "type": "boolean", "operation": "true" } }
          ]
        },
        "options": {}
      },
      "id": "node-if-ok",
      "name": "Rebooked?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [480, 180]
    },
    {
      "parameters": {
        "text": "No-show rebooked: {{ $json.appointment.calendarId }} → {{ $json.appointment.startTime }}",
        "options": {}
      },
      "id": "node-log",
      "name": "Log rebook",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [760, 60]
    },
    {
      "parameters": {
        "text": "No free slot within 7 days — escalate to front desk",
        "options": {}
      },
      "id": "node-escalate",
      "name": "Escalate",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [760, 300]
    }
  ],
  "connections": {
    "GHL Appointment Event": {
      "main": [[{ "node": "Is a no-show?", "type": "main", "index": 0 }]]
    },
    "Is a no-show?": {
      "main": [[{ "node": "Vercel: rebook next free slot + queue WhatsApp", "type": "main", "index": 0 }]]
    },
    "Vercel: rebook next free slot + queue WhatsApp": {
      "main": [[{ "node": "Rebooked?", "type": "main", "index": 0 }]]
    },
    "Rebooked?": {
      "main": [
        [{ "node": "Log rebook", "type": "main", "index": 0 }],
        [{ "node": "Escalate", "type": "main", "index": 0 }]
      ]
    }
  },
  "settings": { "executionOrder": "v1" }
}
