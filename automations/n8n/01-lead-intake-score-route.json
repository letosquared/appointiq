{
  "name": "Lead Intake → Score → Route (GHL Contacts)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "ghl-lead",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "node-webhook",
      "name": "GHL Contact Created",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [-240, 220]
    },
    {
      "parameters": {
        "url": "https://appointiq-webp.vercel.app/api/automations/qualify",
        "method": "POST",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "X-API-Secret", "value": "={{ $env.WEBHOOK_SECRET }}" },
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{\n  \"contactId\": \"={{ $json.data.contactId }}\",\n  \"message\": \"={{ $json.data.message ?? '' }}\",\n  \"force\": false\n}",
        "options": {}
      },
      "id": "node-qualify",
      "name": "Vercel: qualify lead (score + reply + route)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [80, 220]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "typeValidation": "loose" },
          "conditions": [
            { "leftValue": "={{ $json.run.tier }}", "rightValue": "hot", "operator": { "type": "string", "operation": "equals" } }
          ]
        },
        "options": {}
      },
      "id": "node-if-hot",
      "name": "Is hot lead?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [360, 220]
    },
    {
      "parameters": {
        "url": "https://appointiq-webp.vercel.app/api/outbox",
        "method": "GET",
        "options": {}
      },
      "id": "node-verify",
      "name": "Verify run recorded",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [640, 220]
    },
    {
      "parameters": {
        "text": "Hot lead {{ $json.run.contactName }} scored {{ $json.run.score }} — routed to {{ $json.run.calendarId }}.",
        "options": {}
      },
      "id": "node-notify",
      "name": "Ops notification placeholder",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [640, 60]
    }
  ],
  "connections": {
    "GHL Contact Created": {
      "main": [[{ "node": "Vercel: qualify lead (score + reply + route)", "type": "main", "index": 0 }]]
    },
    "Vercel: qualify lead (score + reply + route)": {
      "main": [[{ "node": "Is hot lead?", "type": "main", "index": 0 }]]
    },
    "Is hot lead?": {
      "main": [
        [{ "node": "Ops notification placeholder", "type": "main", "index": 0 }],
        [{ "node": "Verify run recorded", "type": "main", "index": 0 }]
      ]
    }
  },
  "settings": { "executionOrder": "v1" }
}
